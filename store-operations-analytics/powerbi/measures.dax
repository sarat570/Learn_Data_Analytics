// Add each measure separately with New measure, not as a single DAX query.
Forecast Units = SUM(FactForecast[ForecastUnits])
Forecast Sales = SUM(FactForecast[ForecastSales])
Holdout Actual Units = SUM(FactBacktest[ActualUnits])
Holdout Forecast Units = SUM(FactBacktest[ForecastUnits])
WAPE % = DIVIDE(SUM(FactBacktest[AbsoluteError]), [Holdout Actual Units])
Baseline WAPE % = DIVIDE(SUM(FactBacktest[BaselineAbsoluteError]), [Holdout Actual Units])
Forecast Bias % = DIVIDE(SUM(FactBacktest[BiasUnits]), [Holdout Actual Units])
MAE = AVERAGE(FactBacktest[AbsoluteError])
RMSE = SQRT(AVERAGE(FactBacktest[SquaredError]))
Purchase Recommendation Cost = SUM(FactPurchasing[OrderCost])
Products at Arrival Risk = SUM(FactPurchasing[StockoutBeforeArrival])
Required Hours = SUM(FactLaborForecast[RequiredHours])
Forecast Labor Cost = SUM(FactLaborForecast[ForecastLaborCost])
Forecast Labor to Sales % = DIVIDE([Forecast Labor Cost], [Forecast Sales])
Scheduled Hours = SUM(FactCoverage[ScheduledHours])
Unfilled Hours = SUM(FactCoverage[UnfilledHours])
Excess Hours = SUM(FactCoverage[ExcessHours])
Timecard Count = COUNTROWS(FactTimekeeping)
Blocked Timecards = CALCULATE(COUNTROWS(FactTimekeeping), FactTimekeeping[EligibleForPay] = 0)
Approved Eligible Hours = CALCULATE(SUM(FactTimekeeping[PaidHours]), FactTimekeeping[EligibleForPay] = 1)
Illustrative Gross Pay = SUM(FactPay[IllustrativeGrossPay])
Regular Pay = SUM(FactPay[RegularPay])
Overtime Pay = SUM(FactPay[OvertimePay])
Overtime Hours = SUM(FactPay[OvertimeHours])
